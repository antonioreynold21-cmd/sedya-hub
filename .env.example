# Browser build. Vite inlines these into the browser bundle.
# Changing them requires a new build, not only a container restart.
# Use the same Supabase project as the server variables below.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server runtime. Required when the process handles authenticated server functions.
# Do not prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Secret runtime for server-only admin operations. Never put this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Optional runtime. Public https origin of this deployment, for example https://hub.example.com.
# Needed for a custom domain so CSRF can accept that origin behind the Railway proxy.
# Railway also provides RAILWAY_PUBLIC_DOMAIN; do not invent that variable yourself.
# APP_URL=

# Optional. Direct Postgres connection for a manual Drizzle migration.
# Not read by the web server at startup, and not required to deploy the web service.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Railway injects PORT. Leave it unset locally; the production server defaults to 3000.
# HOST defaults to 0.0.0.0 in `bun run start`. NITRO_HOST overrides it.
